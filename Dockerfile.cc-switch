FROM alpine:3.19

RUN apk add --no-cache curl ca-certificates

# 下载 CC Switch CLI（Linux x64 musl 静态链接版）
RUN curl -LO https://github.com/SaladDay/cc-switch-cli/releases/latest/download/cc-switch-cli-linux-x64-musl.tar.gz \
 && tar -xzf cc-switch-cli-linux-x64-musl.tar.gz \
 && chmod +x cc-switch \
 && mv cc-switch /usr/local/bin/ \
 && rm -f cc-switch-cli-linux-x64-musl.tar.gz

# CC Switch 配置目录
RUN mkdir -p /root/.cc-switch

# 数据持久化
VOLUME ["/root/.cc-switch"]

# 代理监听端口（Claude: 15721, Codex: 15722, Gemini: 15723）
EXPOSE 15721 15722 15723

# 入口脚本：如果已配置 Provider 则启动代理，否则保持容器运行等待配置
# 首次使用流程：
#   1. docker exec -it tide-cc-switch cc-switch provider add
#   2. docker exec -it tide-cc-switch cc-switch proxy enable
#   3. docker restart tide-cc-switch
RUN printf '#!/bin/sh\nif cc-switch provider current >/dev/null 2>&1; then\n  echo "[cc-switch] Provider found, starting proxy..."\n  exec cc-switch proxy serve --takeover claude --listen-address 0.0.0.0\nelse\n  echo "[cc-switch] No provider configured. Container is idle."\n  echo "[cc-switch] Run: docker exec -it tide-cc-switch cc-switch provider add"\n  echo "[cc-switch] Then: docker restart tide-cc-switch"\n  exec tail -f /dev/null\nfi\n' > /entrypoint.sh \
 && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
