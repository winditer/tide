# ===================== Lark 应用凭据和回调 =====================
# Lark 自建应用的 App ID / Secret。不要把真实 secret 提交到 Git。
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx

# Lark 国际版使用 open.larksuite.com；飞书国内版才使用 open.feishu.cn。
LARK_DOMAIN=https://open.larksuite.com

# 事件订阅的 Encrypt Key / Verification Token；WebSocket 长连接也会使用这些校验事件。
LARK_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=


# ===================== Codex 基础执行配置 =====================
# 默认工作目录，以及 Codex 本地会话目录。
CODEX_DEFAULT_CWD=/Users/haifeng/Documents/lark2codex
CODEX_HOME=/Users/haifeng/.codex
CODEX_SESSIONS_DIR=/Users/haifeng/.codex/sessions

# Codex CLI 命令、单次任务超时、默认模型。
CODEX_BIN=codex
CODEX_TIMEOUT_SECONDS=1800
CODEX_MODEL=

# 默认 Agent，以及 Claude Code / Qoder CLI 配置。DEFAULT_AGENT_ID 可设 codex、claude 或 qoder。
DEFAULT_AGENT_ID=codex
CLAUDE_BIN=claude
CLAUDE_HOME=/Users/haifeng/.claude
CLAUDE_PROJECTS_DIR=/Users/haifeng/.claude/projects
CLAUDE_TIMEOUT_SECONDS=1800
CLAUDE_MODEL=
CLAUDE_PERMISSION_MODE=dontAsk
APPROVED_CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_EXTRA_ARGS=
QODER_BIN=qodercli
QODER_HOME=/Users/haifeng/.qoder
QODER_PROJECTS_DIR=/Users/haifeng/.qoder/projects
QODER_PROCESS_HOME=/Users/haifeng
QODER_TIMEOUT_SECONDS=1800
QODER_MODEL=
QODER_PERMISSION_MODE=dont_ask
APPROVED_QODER_PERMISSION_MODE=bypass_permissions
QODER_QUEST_TIMEOUT_SECONDS=43200
QODER_EXTRA_ARGS=

# 新建项目的根目录。多个值用逗号或分号分隔，前端弹窗会显示为下拉选择。
# 为空时使用 CODEX_DEFAULT_CWD 的父目录。
CODEX_PROJECTS_ROOT=

# 普通 Codex 任务的审批和沙箱策略。Claude Code / Qoder CLI 使用各自的 PERMISSION_MODE。
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX_MODE=workspace-write

# Lark 审批批准后，单次重试使用的审批和沙箱策略。
APPROVED_CODEX_APPROVAL_POLICY=on-request
APPROVED_CODEX_SANDBOX_MODE=workspace-write

# 允许 Codex 执行、/cd、项目创建和 Plan worktree 运行的目录范围；多个路径可用 : 或 , 分隔。
CODEX_ALLOWED_ROOTS=/Users/haifeng/Documents


# ===================== Lark 访问控制和敏感操作权限 =====================
# 允许使用 bridge 的群聊 ID。为空时由 LARK_REQUIRE_KNOWN_CHAT 控制；填 * 表示允许所有群。
LARK_ALLOWED_CHAT_IDS=

# 允许操作 bridge 的用户 open_id。为空表示不按用户过滤。
LARK_ALLOWED_OPEN_IDS=

# 可执行审批、停止、重启、切目录、提交等敏感操作的管理员 open_id。为空时沿用允许用户。
LARK_ADMIN_OPEN_IDS=

# 未配置 LARK_ALLOWED_CHAT_IDS 时，是否仅允许状态文件中已有的 chat。
LARK_REQUIRE_KNOWN_CHAT=1


# ===================== Lark 消息、卡片和面板展示 =====================
# 长消息分片长度，以及最终回复/用户问题在卡片中的最大展示长度。
LARK_MESSAGE_CHUNK_SIZE=1800
LARK_FINAL_REPLY_MAX_CHARS=4000
LARK_FINAL_QUESTION_MAX_CHARS=1200

# 看板展示数量，以及每类 Agent session 文件数量上限。
MAX_PROJECTS_IN_PANEL=8
MAX_CONVERSATIONS_IN_PANEL=8
MAX_SESSION_FILES=5000

# Lark 事件队列和 Agent 进程并发保护。
MAX_RUNNING_TASKS=6
MAX_RUNNING_TASKS_PER_CHAT=4
LARK_EVENT_QUEUE_MAXSIZE=200

# 图片/文件附件下载目录。相对路径会落到当前 Agent 工作目录下，确保 workspace-write sandbox 可读取。
LARK_ATTACHMENTS_DIR=.tide/attachments
LARK_ATTACHMENT_MAX_BYTES=52428800
LARK_PENDING_ATTACHMENT_TTL_SECONDS=900
MAX_LARK_ATTACHMENTS_PER_MESSAGE=8

# Agent 指令卡自动刷新间隔。
TASK_CARD_REFRESH_INTERVAL_SECONDS=15

# 是否允许 Lark 卡片被转发。控制类卡片建议保持 0。
LARK_CARD_ENABLE_FORWARD=0

# WebSocket 脚本启动时向已知 Lark 会话发送的欢迎语；设为空可关闭。
TIDE_WELCOME_MESSAGE=I'm Tide, a lightweight multi-agent bridge for Lark.


# ===================== 审批等待配置 =====================
# 推送审批后等待用户处理的时间，以及轮询审批状态的间隔。
PENDING_APPROVAL_WAIT_SECONDS=300
PENDING_APPROVAL_POLL_SECONDS=2


# ===================== Plan 并行任务配置 =====================
# /plan 并行执行的最大子任务数，以及每个子任务在 Plan 面板中的输出长度。
PLAN_MAX_PARALLEL=3
PLAN_TASK_OUTPUT_MAX_CHARS=1200

# 是否为 Plan 子任务启用 Git worktree 隔离；自定义 worktree 根目录为空时使用仓库内 .tide/worktrees。
PLAN_USE_WORKTREES=1
PLAN_WORKTREE_ROOT=

# Plan 子任务完成后、进入提交审批前执行的检查命令。默认不用 shell 执行。
PLAN_TEST_COMMAND=git diff --check
PLAN_TEST_COMMAND_SHELL=0
PLAN_TEST_TIMEOUT_SECONDS=120


# ===================== 状态推送、日报和本地持久化 =====================
# 定时推送当前状态的间隔；0 表示关闭。
STATUS_INTERVAL_SECONDS=0

# 每日项目进展日报推送时间。
DAILY_REPORT_TIME=19:00

# 本地运行状态文件；保存已知 chat、运行面板状态和 Plan/子任务状态。
TIDE_STATE_FILE=.tide_state.json

# 是否显示已归档项目/会话；是否把 Plan worktree 子目录统计进看板和日报。
# TIDE_SHOW_ARCHIVED 接受 0/false/no/off 为隐藏，1/true/yes/on 为显示。
# 项目和会话的归档状态独立持久化在 TIDE_ARCHIVE_FILE（默认 .tide_archived.json）。
TIDE_SHOW_ARCHIVED=0
TIDE_ARCHIVE_FILE=.tide_archived.json
TIDE_INCLUDE_PLAN_WORKTREES=0


# ===================== Codex Desktop 会话同步 =====================
# 是否监听 Codex Desktop 会话更新；开启后会把 Desktop 会话变化同步到 Lark。
SYNC_DESKTOP_SESSIONS=0
SESSION_WATCH_INTERVAL_SECONDS=3


# ===================== macOS 保活 =====================
# 接入电源时自动启动 caffeinate；可选开启 pmset disablesleep。
KEEP_AWAKE_ON_AC_POWER=1
KEEP_AWAKE_CHECK_INTERVAL_SECONDS=60
KEEP_AWAKE_DISABLE_SLEEP=0


# ===================== 日志 =====================
# 默认不记录 Lark 消息正文和 Agent prompt 片段。
LOG_MESSAGE_CONTENT=0
LOG_LEVEL=INFO


# ===================== 认证 =====================
TIDE_JWT_SECRET=your-super-secret-key-change-in-production
TIDE_JWT_ALGORITHM=HS256
TIDE_JWT_EXPIRE_MINUTES=15
TIDE_REFRESH_TOKEN_EXPIRE_DAYS=30
TIDE_REQUIRE_AUTH=1
NEXT_PUBLIC_TIDE_REQUIRE_AUTH=1
TIDE_ADMIN_USERNAME=admin
TIDE_ADMIN_PASSWORD=
LARK_APP_REDIRECT_URI=
TIDE_PASSWORD_MIN_LENGTH=8
TIDE_DATA_DIR=/app/data


WORKITEM_SMART_ROUTING=false

# AI描述优化使用的Agent ID（留空则使用DEFAULT_AGENT_ID）
OPTIMIZE_AGENT_ID=
