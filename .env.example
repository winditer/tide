LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
LARK_DOMAIN=https://open.larksuite.com
LARK_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=
CODEX_DEFAULT_CWD=/Users/haifeng/Documents/lark2codex
CODEX_HOME=/Users/haifeng/.codex
CODEX_SESSIONS_DIR=/Users/haifeng/.codex/sessions
CODEX_BIN=codex
CODEX_TIMEOUT_SECONDS=1800
CODEX_MODEL=
CODEX_PROJECTS_ROOT=
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX_MODE=workspace-write
APPROVED_CODEX_APPROVAL_POLICY=never
APPROVED_CODEX_SANDBOX_MODE=danger-full-access
LARK_MESSAGE_CHUNK_SIZE=1800
LARK_FINAL_REPLY_MAX_CHARS=4000
LARK_FINAL_QUESTION_MAX_CHARS=1200
MAX_PROJECTS_IN_PANEL=8
MAX_CONVERSATIONS_IN_PANEL=8
MAX_SESSION_FILES=300
STATUS_INTERVAL_SECONDS=0
TASK_CARD_REFRESH_INTERVAL_SECONDS=15
PENDING_APPROVAL_WAIT_SECONDS=300
PENDING_APPROVAL_POLL_SECONDS=2
PLAN_MAX_PARALLEL=3
PLAN_TASK_OUTPUT_MAX_CHARS=1200
PLAN_USE_WORKTREES=1
PLAN_WORKTREE_ROOT=
PLAN_TEST_COMMAND=git diff --check
PLAN_TEST_TIMEOUT_SECONDS=120
DAILY_REPORT_TIME=19:00
LARK_CODEX_STATE_FILE=.lark_codex_state.json
LARK_CODEX_SHOW_ARCHIVED=0
LARK_CODEX_WELCOME_MESSAGE=I'm Lark Codex, a lightweight agent that helps you use lark to work perfectly with Codex!
SYNC_DESKTOP_SESSIONS=1
SESSION_WATCH_INTERVAL_SECONDS=3
KEEP_AWAKE_ON_AC_POWER=1
KEEP_AWAKE_CHECK_INTERVAL_SECONDS=60
KEEP_AWAKE_DISABLE_SLEEP=0
LOG_LEVEL=INFO
