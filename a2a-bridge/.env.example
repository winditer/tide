# ==========================================================================
# Tide A2A Bridge 环境变量示例
# 复制为 .env 后按需修改；docker-compose 或 systemd 启动时自动加载
# ==========================================================================

# ----- 服务监听 -----
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8720
# 公开访问 URL，会写入 Agent Card 的 url 字段（包含协议 + host + 端口）
# 留空则自动根据请求 Host 推导
BRIDGE_PUBLIC_URL=

# ----- 认证 -----
# 留空表示禁用认证（仅用于内网调试）。生产建议必须设置。
BRIDGE_API_KEY=

# ----- 工作目录与并发 -----
BRIDGE_WORK_DIR=/home/deploy/workspace
BRIDGE_MAX_CONCURRENCY=5
BRIDGE_DEFAULT_TIMEOUT=600
BRIDGE_DEFAULT_AGENT=codex
BRIDGE_LOG_LEVEL=INFO

# ----- Codex CLI -----
CODEX_BIN=codex
CODEX_MODEL=auto
CODEX_TIMEOUT=600
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX_MODE=workspace-write

# ----- Claude Code CLI -----
CLAUDE_BIN=claude
CLAUDE_MODEL=
CLAUDE_TIMEOUT=600
CLAUDE_PERMISSION_MODE=acceptEdits

# ----- Qoder CLI -----
QODER_BIN=qoder
QODER_MODEL=
QODER_TIMEOUT=600
QODER_PERMISSION_MODE=acceptEdits

# ----- 高级：JSON 形式覆盖整个 AGENTS 配置（可选） -----
# 一旦设置，将完全替代上面的 *_BIN / *_MODEL 等字段
# BRIDGE_AGENTS={"codex":{"bin":"/usr/local/bin/codex","model":"auto","timeout":900}}

# ----- 上游 LLM API（透传给 CLI） -----
# 视所选 CLI 与代理网关而定，此处仅示例：
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# CODEX_HOME=/home/deploy/.codex

# ----- Git 集成 -----
# 仓库本地存储目录（不同仓库会被放在 子目录 org_repo 下）
GIT_REPOS_DIR=/tmp/a2a-repos
# SSH 私钥路径（用于 git@ 协议仓库，需要可读）
GIT_SSH_KEY_PATH=
# HTTPS 认证 token（用于 https:// 协议仓库）
GIT_AUTH_TOKEN=
# 默认仓库 URL（请求未携带 git.repoUrl 时使用，留空表示不启用 git 集成）
GIT_DEFAULT_REPO=
# 默认基线分支
GIT_DEFAULT_BRANCH=main
# 任务结束后是否自动 commit + push
GIT_AUTO_PUSH=true

# ── Daemon WebSocket 推模式 ─────────────────────────────
# 启用后 Bridge 将主动连接 Tide 后端的 /ws/daemon 端点，
# 替代传统的 HTTP 轮询模式，实现：能力注册、心跳保活、任务反向下发。
# 适用于 NAT/防火墙后无法被主动 reach 的 Bridge 实例。

# Bridge 显示名称（用作 Agent 名称前缀，如 dev/codex）
# 留空则自动使用主机名，再次回退到 daemon_id 前8位
BRIDGE_NAME=

# 是否启用 Daemon 推模式（默认 false，不影响现有 HTTP 模式）
DAEMON_ENABLED=false

# Tide 后端 WebSocket 地址（如 ws://localhost:8000/ws/daemon）
TIDE_WS_URL=

# 与后端 DAEMON_TOKEN 相同的共享密钥（鉴权用）
DAEMON_TOKEN=

# Daemon 标识符（留空则自动生成 UUID，多实例部署时建议手动指定）
DAEMON_ID=

# 心跳间隔（秒），服务端确认后可能下发不同值
HEARTBEAT_INTERVAL=15

# 能力标签（逗号分隔），供后端调度匹配使用
CAPABILITY_TAGS=code,review,docs
