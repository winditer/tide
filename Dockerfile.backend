FROM node:22-slim AS agent-cli

# 全局安装 Agent CLI（linux-x64 平台包由 npm 自动解析 optional dep）
RUN npm install -g @openai/codex \
    @anthropic-ai/claude-code @qoder-ai/qodercli


FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 从 builder 阶段复制 Node.js 运行时和已安装的 Agent CLI
COPY --from=agent-cli /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=agent-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=agent-cli /usr/local/bin/npm /usr/local/bin/npm
COPY --from=agent-cli /usr/local/bin/npx /usr/local/bin/npx
# CLI 入口必须保留为符号链接（指向 node_modules 内的脚本），
# 否则 __dirname 会变成 /usr/local/bin，导致 require.resolve 无法在全局 node_modules 中查找包
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
 && ln -s /usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/local/bin/claude \
 && ln -s /usr/local/lib/node_modules/@qoder-ai/qodercli/bundle/qodercli.js /usr/local/bin/qodercli

# qodercli 需要 policies 目录在二进制同级路径下
RUN ln -s /usr/local/lib/node_modules/@qoder-ai/qodercli/bundle/policies /usr/local/bin/policies

# git 用于 Plan worktree；curl 用于健康检查与调试
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# 先复制依赖清单以利用层缓存
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# 复制后端源码（前端、node_modules 等不需要）
COPY backend/ ./backend/
COPY scripts/ ./scripts/

# 持久化目录：SQLite 数据库 + .tide 运行时 + Agent 工作目录
RUN mkdir -p /app/data /app/.tide /app/.agent/codex /app/.agent/claude /app/.agent/qoder

# Claude CLI settings - API 请求通过 CC Switch 代理路由（不使用 HTTP_PROXY）
RUN mkdir -p /root/.claude && echo '{"theme":"dark","env":{"ANTHROPIC_API_KEY":"PROXY_MANAGED","ANTHROPIC_BASE_URL":"http://tide-cc-switch:15721"}}' > /root/.claude/settings.json

# 默认把 SQLite 写到挂载卷
ENV DATABASE_URL=sqlite+aiosqlite:////app/data/tide.db \
    CODEX_HOME=/app/.agent/codex \
    CLAUDE_HOME=/app/.agent/claude \
    QODER_HOME=/app/.agent/qoder

EXPOSE 8000

# 单进程运行：APScheduler / Lark Listener / WS Hub 都依赖进程内内存状态，禁止 --workers > 1
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
